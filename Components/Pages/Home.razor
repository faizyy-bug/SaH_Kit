@page "/"
@rendermode InteractiveServer
@inject VisitService visitService

<h1>Bezoek Form</h1>

<label>Klantnaam:</label>
<input type="text" @bind="clientName"/>

<label>Categorie:</label>
<select @bind="skill">
    @foreach (string value in Enum.GetNames(typeof(Skill)))
    {
        <option>@value</option>
    }
</select>

<label>Duur (minuten):</label>
<input type="number" @bind="duration"/>

<label>Probleem opgelost?</label>
<input type="checkbox" @bind="IsChecked"/><br/>

<label>Notities:</label>
<textarea @bind="notes" rows="3"></textarea>

<p class="error-msg">@errorMessage</p>
<button @onclick="AddVisit">Toevoegen aan bezoekenlijst</button>

@code
{
    private string clientName = "";
    private string skill = "Software_Installatie";
    private double duration_;
    private double duration
    {
        get
        { return duration_; }
        set
        {
            if (value >= 0 && value <= 1440)
            {
                duration_ = value;
            }
        }
    }
    private bool IsChecked = false;
    private string notes = "";
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        visitService.LoadVisits();
    }

    private void AddVisit()
    {
        if (string.IsNullOrWhiteSpace(clientName))
        {
            errorMessage = "Vul een klantnaam in.";
            return;
        }

        if (duration <= 0)
        {
            errorMessage = "Vul een geldige duur in";
            return;
        }
        errorMessage = "";
        Enum.TryParse(skill, out Skill parsedSkill);
        visitService.visits.Add(item: new Visit(clientName, parsedSkill, IsChecked, duration, notes));
        clientName = "";
        notes = "";
        duration = 0;
        IsChecked = false;
        skill = "Software_Installatie";
        visitService.SaveVisits();
    }
}