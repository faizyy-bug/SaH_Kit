@page "/"
@rendermode InteractiveServer
@using System.Text.Json;

<div style="max-width: 400px; margin: 20px; font-family: sans-serif;">
    <h1>SaH ToolKit</h1>

    <label>Klantnaam:</label><br/>
    <input type="text" @bind="clientName" style="width: 100%; padding: 5px; margin-bottom: 10px;"/>

    <label>Category:</label><br/>
    <select @bind="skill" style="width: 100%; padding: 5px; margin-bottom: 10px;">
        @foreach (string value in Enum.GetNames(typeof(Skill)))
        {
            <option>@value</option>
        }
    </select>

    <label>Duur (minuten):</label><br/>
    <input type="number" @bind="duration" style="width: 100%; padding: 5px; margin-bottom: 10px;"/>

    <label>Probleem opgelost?</label>
    <input type="checkbox" @bind="IsChecked"  style="margin-bottom: 10px;"/><br/>

    <label>Notities:</label><br/>
    <textarea @bind="notes" style="width: 100%; padding: 5px; margin-bottom: 10px;" rows="3"></textarea>
    <p style="color: red;">@errorMessage</p>
    <button @onclick="AddVisit" style="padding: 10px 20px;">Toevoegen aan bezoekenlijst</button>

    @foreach (Visit visit in visits)
    {
        <p>@visit.Name_Client - @visit.Category - @visit.Fixed - @visit.Notes</p>
    }
</div>

@code
{
    private string _path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData), "sah_visits.json");
    List<Visit> visits = new List<Visit>();
    private string clientName = "";
    private string skill = "Software_Installatie";
    private double duration_;
    private double duration
    {
        get
        { return duration_; }
        set
        {
            if (value >= 0 && value <= 1440)
            {
                duration_ = value;
            }
        }
    }
    private bool IsChecked = false;
    private string notes = "";
    private string errorMessage = "";

    protected override void OnInitialized()
    {
        LoadVisits();
    }

    private void AddVisit()
    {
        if (string.IsNullOrWhiteSpace(clientName))
        {
            errorMessage = "Vul een klantnaam in.";
            return;
        }

        if (duration <= 0)
        {
            errorMessage = "Vul een geldige duur in";
            return;
        }
        errorMessage = "";
        Enum.TryParse(skill, out Skill parsedSkill);
        visits.Add(item: new Visit(clientName, parsedSkill, IsChecked, duration, notes));
        clientName = "";
        notes = "";
        duration = 0;
        IsChecked = false;
        skill = "Software_Installatie";
        SaveVisits();
    }

    private void SaveVisits()
    {
        string json = JsonSerializer.Serialize(visits);
        File.WriteAllText(_path, json);
    }

    private void LoadVisits()
    {
        try
        {
            if (File.Exists(_path))
            {
                string json = File.ReadAllText(_path);
                visits = JsonSerializer.Deserialize<List<Visit>>(json);
            }
        }
        catch { throw new FileLoadException(); }
    }

}