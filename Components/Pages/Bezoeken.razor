@page "/bezoeken"
@rendermode InteractiveServer
@using System.Text.Json
@inject VisitService visitService

<div style="max-width: 700px; margin: 20px; font: JetBrains Mono;">
    <h1>Bezoeken</h1>

    @foreach (Visit visit in visitService.visits)
    {
        <p> @visit.Name_Client - @visit.Category - @visit.Fixed - @visit.Notes</p>
    }
</div>

@code
{
    protected override void OnInitialized()
    {
        visitService.LoadVisits();
    }
}
